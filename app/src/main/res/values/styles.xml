<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="VinilosTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/hint_text_color</item>
        <item name="android:textColorHint">@color/text_primary</item>
        <item name="boxBackgroundColor">@color/field_background</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxStrokeColor">@color/text_secondary</item>
    </style>

    <style name="VinilosTextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintTextColor">@color/hint_text_color</item>
        <item name="android:textColorHint">@color/text_primary</item>
        <item name="boxBackgroundColor">@color/field_background</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxStrokeColor">@color/text_secondary</item>
    </style>

</resources>
