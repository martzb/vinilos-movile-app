<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_background"
    android:gravity="center">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_add"
        android:background="@drawable/bg_avatar_circle"
        android:backgroundTint="@color/accent_purple"
        app:tint="@android:color/white"
        android:padding="20dp"
        android:contentDescription="Éxito" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="¡Track agregado!"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:text="El track fue asociado\nexitosamente al álbum"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewAlbum"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Ver álbum →"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:backgroundTint="@color/accent_purple"
        app:cornerRadius="28dp" />

</LinearLayout>
